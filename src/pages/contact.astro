---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageFrame from '../components/ImageFrame.astro';
import { contactPage, settings } from '../content/site';
---

<BaseLayout title="Contact" description={`Contact information for ${settings.name}.`}>
  <section class="page-hero container narrow contact-panel">
      <p class="eyebrow">{contactPage.eyebrow}</p>
      <h1>{contactPage.title}</h1>
      <p class="lead">{contactPage.intro}</p>
      {settings.email ? <a class="button primary" href={`mailto:${settings.email}`}>{settings.email}</a> : <p class="lead">Email address coming soon.</p>}
  </section>

  <section class="section container two-column">
    <div>
      <h2>{contactPage.locationTitle}</h2>
      <p>{settings.location}</p>
      <ImageFrame image={contactPage.image} variant="wide" />
    </div>
    <div class="prose">
      <h2>{contactPage.inquiryTitle}</h2>
      <ul class="plain-list">
        {contactPage.inquiryItems.map((item) => <li>{item}</li>)}
      </ul>
      <h2>{contactPage.privacyTitle}</h2>
      <p>{contactPage.privacyText}</p>
      <h2>{contactPage.socialTitle}</h2>
      {settings.socials.length > 0 ? settings.socials.map((social) => <p><a href={social.url}>{social.label}</a></p>) : <p>Social links coming soon.</p>}
    </div>
  </section>
</BaseLayout>
