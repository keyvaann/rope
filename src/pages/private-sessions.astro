---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageFrame from '../components/ImageFrame.astro';
import { privateSessionsPage, settings } from '../content/site';

const base = import.meta.env.BASE_URL;
const withBase = (href: string) => `${base.replace(/\/$/, '')}/${href.replace(/^\//, '')}`;
const inquiryHref = settings.email ? `mailto:${settings.email}?subject=Private%20Session%20Inquiry` : withBase('/contact/');
---

<BaseLayout title="Private Sessions" description="Private shibari instruction for individuals, couples, and small groups.">
  <section class="page-hero container hero-grid">
    <div>
      <p class="eyebrow">{privateSessionsPage.eyebrow}</p>
      <h1>{privateSessionsPage.title}</h1>
      <p class="lead">{privateSessionsPage.intro}</p>
      <a class="button primary" href={inquiryHref}>Inquire about sessions</a>
    </div>
    <ImageFrame image={privateSessionsPage.image} variant="portrait" priority />
  </section>

  <section class="section container two-column">
    <div>
      <h2>{privateSessionsPage.bulletsTitle}</h2>
    </div>
    <div class="stack">
      {privateSessionsPage.bullets.map((item) => <p class="quote-card">{item}</p>)}
    </div>
  </section>

  <section class="section container two-column">
    <div>
      <h2>{privateSessionsPage.expectTitle}</h2>
    </div>
    <div class="prose">
      {privateSessionsPage.expectText.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section container two-column">
    <div>
      <h2>{privateSessionsPage.topicsTitle}</h2>
    </div>
    <div class="list-panel">
      {privateSessionsPage.topics.map((topic) => <span>{topic}</span>)}
    </div>
  </section>

  <section class="section container two-column">
    <div>
      <h2>{privateSessionsPage.notOfferedTitle}</h2>
    </div>
    <div class="stack">
      {privateSessionsPage.notOffered.map((item) => <p class="quote-card">{item}</p>)}
    </div>
  </section>

  <section class="section blush-panel">
    <div class="container">
      <p class="eyebrow">{privateSessionsPage.pricingEyebrow}</p>
      <div class="price-grid">
        {privateSessionsPage.pricing.map((item) => (
          <div class="price-card">
            <span>{item.label}</span>
            <strong>{item.price}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section container two-column">
    <div>
      <h2>{privateSessionsPage.safetyTitle}</h2>
    </div>
    <div class="prose">
      {privateSessionsPage.safetyText.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section container two-column">
    <div>
      <h2>{privateSessionsPage.practicalTitle}</h2>
    </div>
    <div class="prose">
      {privateSessionsPage.practicalText.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section container two-column">
    <div>
      <h2>{privateSessionsPage.clothingTitle}</h2>
    </div>
    <div class="prose">
      <p>{privateSessionsPage.clothingText}</p>
    </div>
  </section>

  <section class="section container prose narrow">
    <h2>{privateSessionsPage.beforeTitle}</h2>
    {privateSessionsPage.beforeText.map((paragraph) => <p>{paragraph}</p>)}
    <ImageFrame image={privateSessionsPage.detailImage} variant="wide" />
  </section>

  <section class="section container two-column">
    <div>
      <h2>{privateSessionsPage.bookingTitle}</h2>
    </div>
    <div class="stack numbered-stack">
      {privateSessionsPage.bookingSteps.map((step, index) => (
        <p class="quote-card"><span>{index + 1}</span>{step}</p>
      ))}
    </div>
  </section>

  <section class="section container prose narrow">
    <h2>{privateSessionsPage.cancellationTitle}</h2>
    <p>{privateSessionsPage.cancellationText}</p>
  </section>

  <section class="section container narrow faq-section">
    <h2>{privateSessionsPage.faqTitle}</h2>
    <div class="stack">
      {privateSessionsPage.faqItems.map((item) => (
        <article class="faq-item">
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
