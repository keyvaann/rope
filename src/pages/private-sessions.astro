---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageFrame from '../components/ImageFrame.astro';
import { privateSessionsPage, settings } from '../content/site';
---

<BaseLayout title="Private Sessions" description="Private shibari instruction for individuals, couples, and small groups.">
  <section class="page-hero container hero-grid">
    <div>
      <p class="eyebrow">{privateSessionsPage.eyebrow}</p>
      <h1>{privateSessionsPage.title}</h1>
      <p class="lead">{privateSessionsPage.intro}</p>
      <a class="button primary" href={`mailto:${settings.email}?subject=Private%20Session%20Inquiry`}>Email to inquire</a>
    </div>
    <ImageFrame image={privateSessionsPage.image} variant="portrait" />
  </section>

  <section class="section container two-column">
    <div>
      <h2>{privateSessionsPage.bulletsTitle}</h2>
    </div>
    <div class="stack">
      {privateSessionsPage.bullets.map((item) => <p class="quote-card">{item}</p>)}
    </div>
  </section>

  <section class="section blush-panel">
    <div class="container">
      <p class="eyebrow">{privateSessionsPage.pricingEyebrow}</p>
      <div class="price-grid">
        {privateSessionsPage.pricing.map((item) => (
          <div class="price-card">
            <span>{item.label}</span>
            <strong>{item.price}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section container prose narrow">
    <h2>{privateSessionsPage.beforeTitle}</h2>
    {privateSessionsPage.beforeText.map((paragraph) => <p>{paragraph}</p>)}
    <ImageFrame image={privateSessionsPage.detailImage} variant="wide" />
  </section>
</BaseLayout>
