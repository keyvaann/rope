---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageFrame from '../components/ImageFrame.astro';
import { classesPage, homePage, settings } from '../content/site';

const base = import.meta.env.BASE_URL;
const withBase = (href: string) => `${base.replace(/\/$/, '')}/${href.replace(/^\//, '')}`;
const cardImages = {
  classOne: classesPage.classes[0].image,
  privateSession: homePage.images.privateSession,
  contact: homePage.images.contact,
};
const getCardImage = (imageKey: string) => cardImages[imageKey as keyof typeof cardImages] ?? homePage.images.invitation;
---

<BaseLayout title={settings.name} description={homePage.intro}>
  <section class="hero hero-feature">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{homePage.heroEyebrow}</p>
        <h1>{homePage.heroTitle}</h1>
        <p class="lead">{homePage.intro}</p>
        <div class="button-row">
          <a class="button primary" href={withBase('/private-sessions/')}>Private Sessions</a>
          <a class="button secondary" href={withBase('/classes/')}>View Classes</a>
        </div>
      </div>
      <ImageFrame image={homePage.images.hero} variant="portrait" priority />
    </div>
  </section>

  <section class="section container two-column invitation-panel">
    <div>
      <p class="eyebrow">{homePage.invitationEyebrow}</p>
      <h2>{homePage.invitationTitle}</h2>
    </div>
    <div class="prose">
      {homePage.invitationText.map((paragraph) => <p>{paragraph}</p>)}
      <ImageFrame image={homePage.images.invitation} variant="wide" />
    </div>
  </section>

  <section class="section blush-panel feature-band">
    <div class="container card-grid">
      {homePage.cards.map((card) => (
        <article class="card">
          <ImageFrame image={getCardImage(card.imageKey)} />
          <h3>{card.title}</h3>
          <p>{card.description}</p>
          <a href={withBase(card.href)}>{card.linkLabel}</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
