---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageFrame from '../components/ImageFrame.astro';
import { aboutPage, settings } from '../content/site';
---

<BaseLayout title="About" description={`About ${settings.teacherName} and ${settings.name}.`}>
  <section class="page-hero container hero-grid">
    <div>
      <p class="eyebrow">{aboutPage.eyebrow}</p>
      <h1>{aboutPage.title}</h1>
      <p class="lead">{aboutPage.bio}</p>
    </div>
    <ImageFrame image={aboutPage.image} variant="portrait" />
  </section>

  <section class="section container two-column">
    <div>
      <h2>{aboutPage.philosophyTitle}</h2>
    </div>
    <div class="stack">
      {aboutPage.philosophy.map((item) => <p class="quote-card">{item}</p>)}
    </div>
  </section>

  <section class="section container prose narrow">
    <h2>{aboutPage.experienceTitle}</h2>
    {aboutPage.experienceText.map((paragraph) => <p>{paragraph}</p>)}
  </section>
</BaseLayout>
