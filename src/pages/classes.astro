---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageFrame from '../components/ImageFrame.astro';
import { classesPage } from '../content/site';
---

<BaseLayout title="Classes" description="Group shibari classes at Love & Rope Studio.">
  <section class="page-hero container narrow">
    <p class="eyebrow">{classesPage.eyebrow}</p>
    <h1>{classesPage.title}</h1>
    <p class="lead">{classesPage.intro}</p>
  </section>

  <section class="section container card-grid">
    {classesPage.classes.map((classItem) => (
      <article class="card">
        <ImageFrame image={classItem.image} />
        <h2>{classItem.title}</h2>
        <p>{classItem.description}</p>
      </article>
    ))}
  </section>

  <section class="section container two-column">
    <div>
      <h2>{classesPage.bringTitle}</h2>
    </div>
    <div class="prose">
      {classesPage.bringText.map((paragraph) => <p>{paragraph}</p>)}
      <ImageFrame image={classesPage.detailImage} variant="wide" />
    </div>
  </section>

  <section class="section consent-band">
    <div class="container narrow">
      <h2>{classesPage.safetyTitle}</h2>
      <p>{classesPage.safetyText}</p>
    </div>
  </section>

  <section class="section container narrow faq-section">
    <h2>{classesPage.faqTitle}</h2>
    <div class="stack">
      {classesPage.faqItems.map((item) => (
        <article class="faq-item">
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
