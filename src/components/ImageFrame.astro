---
interface ImageInfo {
  src: string;
  alt: string;
  label: string;
  size: string;
}

interface Props {
  image: ImageInfo;
  variant?: 'landscape' | 'portrait' | 'wide';
}

const { image, variant = 'landscape' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = image.src.replace(/^\//, '');
const imagePath = `${base.replace(/\/$/, '')}/${path}`;
---

<figure class={`image-frame ${variant}`}>
  <img src={imagePath} alt={image.alt} loading="lazy" />
</figure>
