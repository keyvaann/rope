---
import '../styles/global.css';
import { navItems, settings } from '../content/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = settings.name, description = settings.tagline } = Astro.props;
const pageTitle = title === settings.name ? settings.name : `${title} | ${settings.name}`;
const base = import.meta.env.BASE_URL;
const withBase = (href: string) => `${base.replace(/\/$/, '')}/${href.replace(/^\//, '')}`;
const currentPath = `/${Astro.url.pathname.replace(base, '').replace(/^\/+/, '')}`;
const normalizePath = (href: string) => href.replace(/\/$/, '') || '/';
const siteUrl = Astro.site ?? new URL('https://keyvaann.github.io');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = new URL(withBase('/images/hero/hero-01.jpg'), siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="nav container" aria-label="Main navigation">
        <a class="brand" href={withBase('/')}>
          <span>{settings.name}</span>
        </a>
        <div class="nav-links">
          {navItems.map((item) => {
            const isActive = normalizePath(currentPath) === normalizePath(item.href);
            return <a href={withBase(item.href)} aria-current={isActive ? 'page' : undefined}>{item.label}</a>;
          })}
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <p class="eyebrow">{settings.name}</p>
          <p>Shibari teaching with care, curiosity, and clear consent.</p>
        </div>
        <div>
          <p>{settings.location}</p>
          {settings.email ? <a href={`mailto:${settings.email}`}>{settings.email}</a> : <p>Email address coming soon.</p>}
        </div>
      </div>
    </footer>
  </body>
</html>
